{
  "name": "CareerTrack (Spring Boot + MySQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/job-application-tracker",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "CareerTrack app",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}
